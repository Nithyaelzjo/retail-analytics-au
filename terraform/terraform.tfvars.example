# Copy this to terraform.tfvars and fill in your values.
# Do NOT commit terraform.tfvars or any file with real secrets to GitHub.

aws_region = "us-east-1"

# Use your default VPC id — find it with:
#   aws ec2 describe-vpcs --filters Name=isDefault,Values=true
vpc_id = "vpc-xxxxxxxx"

# At least 2 subnets in different AZs from that VPC:
#   aws ec2 describe-subnets --filters Name=vpc-id,Values=vpc-xxxxxxxx
subnet_ids = ["subnet-aaaaaaa", "subnet-bbbbbbb"]

db_username = "retail_admin"
db_name     = "retail_analytics"

# Better: don't put the password here at all — instead run terraform with:
#   TF_VAR_db_password="your-password" terraform apply
